app.get('/health', (req, res) => {
    res.json({
        status: 'online',
        service: 'Zebra ZC300 Print Service',
        timestamp: new Date().toISOString()
    });
});

/**
 * Get available printers
 */
app.get('/printers', (req, res) => {
    try {
        const printers = getAvailablePrinters();
        res.json({
            success: true,
            printers: printers.map(p => ({
                name: p.name,
                status: p.status,
                isDefault: p.isDefault
            }))
        });
    } catch (error) {
        res.status(500).json({
            success: false,
            error: error.message
        });
    }
});

/**
 * Main print endpoint - receives card data and prints to Zebra
 */
app.post('/print', async (req, res) => {
    try {
        const cardData = req.body;
        
        // Validate required fields
        if (!cardData.cardNumber) {
            return res.status(400).json({
                success: false,
                error: 'cardNumber is required'
            });
        }
        
        console.log('📄 Print request received:', {
            cardNumber: cardData.cardNumber,
            userName: cardData.userName,
            userId: cardData.userId,
            timestamp: new Date().toISOString()
        });
        
        // Generate ZPL commands
        const zplData = generateCardZPL(cardData);
        
        console.log('📝 Generated ZPL commands');
        
        // Send to printer
        const result = await sendToPrinter(zplData);
        
        res.json({
            success: true,
            message: 'Card sent to printer successfully',
            method: result.method,
            printer: CONNECTION_TYPE === 'network' 
                ? `${PRINTER_IP}:${PRINTER_PORT}`
                : PRINTER_NAME
        });
        
    } catch (error) {
        console.error('❌ Print error:', error);
        res.status(500).json({
            success: false,
            error: error.message
        });
    }
});

